# Copy to .env (gitignored) and fill in real values for your deployment.
# The app reads these via process.env; nothing auto-loads .env, so pass
# them through your process manager / host's env config (see DEPLOY.md).

# Required. Password for the single shared admin login (ticket #10). Without
# this set, admin routes are unreachable -- the app fails closed, not open.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Port the app listens on. Default: 3000.
PORT=3000

# Turso (hosted libSQL) connection -- the production database. Get these from
# `turso db show <name> --url` and `turso db tokens create <name>` (see
# DEPLOY.md). If DATABASE_URL is unset, the app falls back to a local file DB
# at file:data/postboard.db -- fine for local dev, not for production (no
# durable disk on the free Render plan).
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=paste-the-turso-token-here

# Note: the canonical timezone (IST / Asia/Kolkata) is NOT configurable here
# by design -- the spec fixes it as a single project-wide constant
# (src/ingest/parseChat.js, src/views/*.js), independent of the host's own
# system timezone. There is nothing to set.
