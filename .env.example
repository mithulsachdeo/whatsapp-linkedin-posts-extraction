# Copy to .env (gitignored) and fill in real values for your deployment.
# The app reads these via process.env; nothing auto-loads .env, so pass
# them through your process manager / host's env config (see README.md).

# Required. Password for the single shared admin login (ticket #10). Without
# this set, admin routes are unreachable -- the app fails closed, not open.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Port the app listens on. Default: 3000.
PORT=3000

# Path to the SQLite database file. Default: data/postboard.sqlite (relative
# to the repo root). Its parent directory is created automatically if
# missing. Put this on persistent storage on your host.
DB_PATH=data/postboard.sqlite

# Folder-watch ingestion (ticket #9), optional. A JSON array of
# {"path","groupId"} objects; each watched folder is polled for new .txt
# exports and fed through the same pipeline as manual upload. groupId must
# match one of the ids in src/ingest/groups.js (currently "product-chai" or
# "pm-collective"). Unset/absent (the default) means folder-watch is off and
# manual browser upload is the only ingestion path.
# WATCHED_FOLDERS=[{"path":"/path/to/synced/product-chai","groupId":"product-chai"}]

# How often (ms) to poll watched folders. Default: 60000 (1 minute). Only
# relevant if WATCHED_FOLDERS is set.
# FOLDER_WATCH_INTERVAL_MS=60000

# Nightly SQLite backup (ticket #11), via VACUUM INTO -- see src/db/backup.js
# for the restore procedure. Directory backups are written to. Default:
# data/backups (relative to the repo root).
# BACKUP_DIR=data/backups

# How often (ms) to take a backup. Default: 86400000 (24h). A backup is also
# always taken once immediately at startup.
# BACKUP_INTERVAL_MS=86400000

# How many days of backups to retain before pruning. Default: 7.
# BACKUP_RETENTION_DAYS=7

# Note: the canonical timezone (IST / Asia/Kolkata) is NOT configurable here
# by design -- the spec fixes it as a single project-wide constant
# (src/ingest/parseChat.js, src/views/*.js), independent of the host's own
# system timezone. There is nothing to set.
